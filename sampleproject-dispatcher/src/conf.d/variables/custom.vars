#
# This file contains the variables defined within a virtual host definition
#
# By default, it is empty and does not define any variable
#
Define CONTENT_FOLDER_NAME sampleproject

#Server aliases to internal Adobe processes
Define LOCALHOST_ALIAS "localhost"
Define LOCALHOST_REGEX_ALIAS "\*.local"
Define LOCALHOST_IP_ALIAS "127.0.0.1"
Define ADOBE_ALIAS "*.adobeaemcloud.net"

#Global Publish Dev, Stage, Prod
Define DEV_PUBLISH_DNS publish-p111111-e2222222.adobeaemcloud.com/
Define STAGE_PUBLISH_DNS publish-p111111-e3333333.adobeaemcloud.com/
Define PROD_PUBLISH_DNS publish-p111111-e4444444.adobeaemcloud.com/

#Pipeline frontend Publish Dev, Stage, Prod
Define PIPELINE_DEV_PUBLISH_DNS static-p111111-e2222222.adobeaemcloud.com/
Define PIPELINE_STAGE_PUBLISH_DNS static-p111111-e3333333.adobeaemcloud.com/
Define PIPELINE_PROD_PUBLISH_DNS static-p111111-e4444444.adobeaemcloud.com/

#Sampleproject Publish Local, Dev, Stage, Prod
Define SAMPLE_PROJECT_LOCAL_PUBLISH_DNS aem-local.sampleproject.com.br
Define SAMPLE_PROJECT_DEV_PUBLISH_DNS aem-dev.sampleproject.com.br
Define SAMPLE_PROJECT_STAGE_PUBLISH_DNS aem-stage.sampleproject.com.br
Define SAMPLE_PROJECT_PROD_PUBLISH_DNS aem-prod.sampleproject.com.br
